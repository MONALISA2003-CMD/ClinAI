{
  "name": "clinai-platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --workspace @clinai/api run start",
    "dev:web": "next dev apps/web",
    "build": "npm run build:api && npm run build:web",
    "build:api": "npm --workspace @clinai/api run build",
    "build:web": "npm --workspace @clinai/web run build",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "test:v26:modules": "node tests/v26-module-contract-audit.mjs",
    "test:v26:ai": "node tests/v26-ai-reliability-audit.mjs",
    "typecheck:web": "npm --workspace @clinai/web run typecheck",
    "typecheck:api": "npm --workspace @clinai/api run build",
    "typecheck": "npm run typecheck:api && npm run typecheck:web",
    "test:v27:audit": "node tests/v27-full-page-audit.mjs",
    "test:all:stability": "node tests/v27-full-page-audit.mjs && node tests/v26-module-contract-audit.mjs && node tests/v26-ai-reliability-audit.mjs && node tests/schema-contract-audit.mjs && node tests/ai-security-scope-audit.mjs && node tests/v28-completion-audit.mjs",
    "test:v28:completion": "node tests/v28-completion-audit.mjs"
  },
  "devDependencies": {
    "@types/node": "latest",
    "concurrently": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  },
  "dependencies": {
    "express": "latest",
    "cors": "latest",
    "zod": "latest",
    "pg": "latest"
  }
}
