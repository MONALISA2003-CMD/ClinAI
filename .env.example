# ClinAI API
DATABASE_URL=
JWT_SECRET=

# Current Gemini authentication.
# Prefer the current Google AI Studio / Google Cloud authorization key.
# Keep this server-side only. Never expose it as NEXT_PUBLIC_GEMINI_API_KEY.
GEMINI_AUTHORIZATION_KEY=
# Backward-compatible variable name; use only if your key is still exposed under this name.
GEMINI_API_KEY=

# Current Gemini model can be overridden without changing application code.
GEMINI_MODEL=gemini-3.8-flash

# Deterministic Python computation and analytics service.
INTELLIGENCE_SERVICE_URL=
# Optional Gemini server-side Python execution for non-clinical analytical tasks. Keep false unless explicitly governed.
GEMINI_ENABLE_CODE_EXECUTION=false
GEMINI_FAST_MODEL=gemini-3.8-flash
GEMINI_REASONING_MODEL=gemini-3.8-flash
# Maximum tool-calling continuation rounds per user request. Keep low on free-tier projects.
GEMINI_FREE_TIER_MODE=true
# Keep below the provider quota to leave a small safety margin.
GEMINI_FREE_DAILY_LIMIT=10
# Minimum spacing between Gemini requests from this API process.
GEMINI_FREE_MIN_INTERVAL_MS=15000
GEMINI_FREE_RPM_LIMIT=4
# Reuse identical recent requests without spending another Gemini request.
GEMINI_FREE_CACHE_MS=300000
GEMINI_FREE_MAX_INPUT_CHARS=18000
# Used only when free-tier mode is disabled.
GEMINI_MAX_TOOL_ROUNDS=2

# Free-only multi-model AI runtime. Paid/trial runtime providers are disabled.
CLINAI_FREE_ONLY_RUNTIME=true
CLINAI_MULTI_MODEL_MODE=true
CLINAI_AI_FALLBACK_ATTEMPTS=4
CLINAI_MULTI_MODEL_CACHE_MS=300000
CLINAI_ALLOW_PUBLIC_AI_WITH_PATIENT_DATA=false
# Hard invariant: an explicitly requested capability may never fall back to an incompatible model.
CLINAI_STRICT_CAPABILITY_ROUTING=true
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Provider-global free-tier safety budgets. Lower these values if your provider dashboard reports lower quotas.
OPENROUTER_FREE_DAILY_LIMIT=45
OPENROUTER_FREE_RPM_LIMIT=18
OPENROUTER_FREE_MIN_INTERVAL_MS=3500
GROQ_FREE_DAILY_LIMIT=20
GROQ_FREE_RPM_LIMIT=4
GROQ_FREE_MIN_INTERVAL_MS=15000

# AI performance controls
CLINAI_PROVIDER_TIMEOUT_MS=15000
CLINAI_QUICK_MAX_TOKENS=700
CLINAI_STANDARD_MAX_TOKENS=1800
CLINAI_CONTEXT_CACHE_MS=30000
# Free-tier runtime uses zero tool continuations by default to preserve provider quotas.
CLINAI_FREE_TOOL_ROUNDS=0

# Phase 1 production boundary
# Public preview is read-only and synthetic. Do not enable demo auth in production.
CLINAI_PUBLIC_PREVIEW=true
CLINAI_ENABLE_DEMO_AUTH=false

# Public development test dataset boundary. Disable before production validation.
CLINAI_PUBLIC_TEST_DATA=true
