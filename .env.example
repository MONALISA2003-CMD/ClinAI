# ClinAI API
DATABASE_URL=
JWT_SECRET=

# Current Gemini authentication.
# Prefer the current Google AI Studio / Google Cloud authorization key.
# Keep this server-side only. Never expose it as NEXT_PUBLIC_GEMINI_API_KEY.
GEMINI_AUTHORIZATION_KEY=
# Backward-compatible variable name; use only if your key is still exposed under this name.
GEMINI_API_KEY=

# Current Gemini model can be overridden without changing application code.
GEMINI_MODEL=gemini-3.8-flash
